# AWS credentials (resolved automatically on AgentCore Runtime via IAM role)
AWS_REGION=us-east-1

# The tools run in the gateway's Lambda (gateway/research_tools): set
# SEARCH_API_KEY and DATABASE_URL there. The GitHub token is in AgentCore
# Identity as the github-mcp API key provider (see README).

# Workspace directory for file operations
WORKSPACE_DIR=/tmp/workspace
